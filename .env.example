# Copy to .env (gitignored) and set real values. Nothing here has a default in the code:
# an unset password makes the tools fail with an explicit message.

DQC_PG_USER=dqc
DQC_PG_PASSWORD=change-me
DQC_PG_DB=dqc
DQC_PG_HOST=localhost
DQC_PG_PORT=5433

# least-privilege service roles
DQC_COPILOT_PASSWORD=change-me        # INSERT on dq.copilot_suggestions only
DQC_READER_PASSWORD=change-me         # SELECT only (dashboard, Grafana)

# required by every API endpoint that writes (X-API-Key header); empty = writes disabled
DQC_API_KEY=

GRAFANA_ADMIN_PASSWORD=change-me

# optional
ANTHROPIC_API_KEY=
DQC_FARE_MODEL_VERSION=
